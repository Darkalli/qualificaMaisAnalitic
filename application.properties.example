# Copie para src/main/resources/application.properties e preencha apenas no arquivo local.
spring.application.name=qualificaMaisAnalitic
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/qualificamais}
spring.datasource.username=${DB_USERNAME:}
spring.datasource.password=${DB_PASSWORD:}
# Flyway cria as tabelas em um schema vazio; Hibernate apenas valida a estrutura.
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.clean-disabled=true

# Primeiro usuário: preencher apenas na primeira inicialização e remover depois.
# Só cria quando app_user estiver vazia; nunca redefine uma conta existente.
app.auth.bootstrap.username=${AUTH_BOOTSTRAP_USERNAME:}
app.auth.bootstrap.password=${AUTH_BOOTSTRAP_PASSWORD:}

app.sheets.spreadsheet-id=${GOOGLE_SHEETS_SPREADSHEET_ID:}
app.sheets.range=${GOOGLE_SHEETS_RANGE:}
app.sheets.header-row=1
app.sheets.credentials-path=classpath:credentials.json
app.sheets.tokens-directory=tokens
app.sheets.oauth-port=8888

app.sheets.check-enabled=${GOOGLE_SHEETS_CHECK_ENABLED:true}
app.sheets.check-interval=${GOOGLE_SHEETS_CHECK_INTERVAL:5m}
app.sheets.check-initial-delay=${GOOGLE_SHEETS_CHECK_INITIAL_DELAY:10s}

# Catálogo automático: mesma planilha, somente Cursos!A:B. Desabilitado até autorizar escrita.
app.sheets.catalog-enabled=${GOOGLE_SHEETS_CATALOG_ENABLED:false}
app.sheets.catalog-sheet-name=Cursos
app.sheets.catalog-interval-ms=300000
app.sheets.catalog-initial-delay-ms=10000
app.sheets.catalog-dispatch-interval-ms=1000
app.sheets.connect-timeout-ms=10000
app.sheets.read-timeout-ms=30000
